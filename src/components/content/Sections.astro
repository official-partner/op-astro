---
import type { HTMLAttributes } from "astro/types";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

/* An item's sections, each one the component of its kind (docs/content.md, Sections). A new kind is a z.object in the
   collection's schema (src/content.config.ts) and a branch here; a hidden section is left out. The list is marked for
   OP System: its source is the item's field (« astro:<collection>/<item>#sections »), each section its id and kind. */
type Section =
  | { type: "text"; id: string; name?: string; hidden?: boolean; text: string }
  | { type: "quote"; id: string; name?: string; hidden?: boolean; quote: string; by?: string };

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The item's sections, as its collection gives them. */
  sections?: Section[];
  /** The collection and the item they belong to: what OP System needs to write them. */
  collection: string;
  item: string;
};

const { render = true, sections = [], collection, item, class: className, ...rest } = Astro.props;
const shown = sections.filter((s) => !s.hidden);
---

{
  render && shown.length > 0 && (
    <ContentWrapper
      class={className}
      data-op-list="sections"
      data-op-source={`astro:${collection}/${item}#sections`}
      {...rest}
    >
      {shown.map((s) =>
        s.type === "quote" ? (
          <figure data-op-item={s.id} data-op-kind="quote">
            <blockquote>
              <Paragraph variant="h4" data-op-field="quote">{s.quote}</Paragraph>
            </blockquote>
            {s.by && <figcaption data-op-field="by">{s.by}</figcaption>}
          </figure>
        ) : (
          <div data-op-item={s.id} data-op-kind="text">
            <Paragraph data-op-field="text">{s.text}</Paragraph>
          </div>
        ),
      )}
    </ContentWrapper>
  )
}
