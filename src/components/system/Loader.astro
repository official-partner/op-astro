---
import { readFileSync } from "node:fs";
import path from "node:path";
import { SITE_NAME } from "@/consts.ts";
import type { LoaderPreset } from "@/utils/finishes.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** `head`: its styles and the script that decides, before the first paint, whether it plays. `cover`: the screen itself, first in the body. */
  part: "head" | "cover";
  /** The screen: the site's mark (`mark`), a count to 100 (`counter`), a curtain in the brand's colour that lifts away (`curtain`), or the site's own (`custom`: src/components/system/LoaderCustom.astro). */
  preset?: LoaderPreset;
}

const { render = true, part, preset: asked = "mark" } = Astro.props;

/* The site's own screen (op.config.json "loader": "custom"), made by Claude from the team's words: its markup and
   styles in LoaderCustom.astro, inside the cover; the cover's timing stays this one's. Missing, the mark stands in. */
const [Custom] = Object.values(
  import.meta.glob<{ default: (props: object) => unknown }>(
    "/src/components/system/LoaderCustom.astro",
    { eager: true },
  ),
).map((m) => m.default);
const preset: LoaderPreset = asked === "custom" && !Custom ? "mark" : asked;

/* The site's mark once it has one (src/assets/logo/mark.svg), else its favicon, drawn from its initial (scripts/favicon.mjs) */
const [mark] = Object.values(
  import.meta.glob<string>("/src/assets/logo/mark.svg", {
    eager: true,
    query: "?raw",
    import: "default",
  }),
);
const favicon = () => {
  try {
    return readFileSync(
      path.join(process.cwd(), "public", "favicon.svg"),
      "utf8",
    );
  } catch {
    return "";
  }
};
const icon =
  part === "cover"
    ? (mark ?? favicon())
        .replace(/<\?xml[\s\S]*?\?>|<!--[\s\S]*?-->/g, "")
        .trim()
    : "";

/* Its styles, inline before the site's stylesheets, so the screen is there at the first paint; the head's stylesheets
   hold that paint until they load, so the tokens are there too */
const CSS = String.raw`
@layer components {
  .loader_wrap {
    display: none;
  }

  html[data-loader] .loader_wrap {
    /* If the script never ends it: gone a second after its longest wait */
    --_failsafe: 3.5s;
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background-color: var(--background);
    color: var(--text);
    transition: opacity var(--loader-duration) var(--loader-ease);
  }

  html[data-loader="play"] .loader_wrap {
    animation: loader-failsafe 1ms linear var(--_failsafe) forwards;
  }

  html[data-loader="leave"] .loader_wrap {
    opacity: 0;
    pointer-events: none;
  }

  /* The curtain: the brand's ground over the page, lifting away whole once the page is ready */
  html[data-loader="leave"] .loader_wrap.curtain {
    opacity: 1;
    translate: 0 -100%;
    transition: translate calc(var(--loader-duration) * 1.5) var(--loader-ease)
      calc(var(--loader-duration) / 4);
  }

  /* The counter: a count to 100 at the foot of the screen and a line filling under it, as the page loads */
  html[data-loader] .loader_wrap.counter {
    place-items: end start;
    padding: var(--site-margin);
  }

  .loader_count {
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .loader_line {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: calc(var(--border-width) * 2);
    background-color: currentcolor;
    transform-origin: 0 50%;
    scale: var(--_progress, 0) 1;
  }

  .loader_mark {
    display: block;
    inline-size: 4rem;
    border-radius: 21.875%;
    overflow: clip;
  }

  .loader_mark > svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* The mark arrives at the first paint (from its starting style), and leaves first */
  .loader_mark,
  .loader_name,
  .loader_count {
    transition:
      opacity calc(var(--loader-duration) * 0.6) var(--ease-smooth),
      translate calc(var(--loader-duration) * 0.6) var(--ease-smooth);
  }

  @starting-style {
    html[data-loader] :is(.loader_mark, .loader_name, .loader_count) {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  html[data-loader="leave"] :is(.loader_mark, .loader_name, .loader_count) {
    opacity: 0;
    translate: 0 -0.5rem;
    transition-duration: calc(var(--loader-duration) / 2);
    transition-timing-function: var(--loader-ease);
  }

  @keyframes loader-failsafe {
    from,
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
}
`;

const SCRIPT = String.raw`
(() => {
  /* The loading screen (src/components/system/Loader.astro): once per tab session, every time with
     ?op-loader in the address (OP System's replay), never again in the same tab nor, unless asked for,
     with reduced motion. It holds at least MIN and at most MAX milliseconds, until the fonts are loaded
     and the first image in view is decoded, then leaves. The counter counts toward 90 while it waits,
     then to 100 once the page is ready, and leaves at 100. */
  const MIN = 600;
  const MAX = 2500;
  const PRESET = "__PRESET__";
  const root = document.documentElement;
  const replay = new URLSearchParams(location.search).has("op-loader");
  let seen = true;
  try {
    seen = sessionStorage.getItem("op-loader") === "1";
    sessionStorage.setItem("op-loader", "1");
  } catch {}
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!replay && (seen || reduce)) return;

  root.dataset.loader = "play";
  const start = performance.now();
  const until = (ms) =>
    new Promise((done) =>
      setTimeout(done, Math.max(0, start + ms - performance.now())),
    );

  const leave = () => {
    if (root.dataset.loader !== "play") return;
    root.dataset.loader = "leave";
    document.dispatchEvent(new Event("op:loader-leave"));
    const end = () => {
      if (root.dataset.loader === "leave") delete root.dataset.loader;
    };
    const cover = document.querySelector(".loader_wrap");
    if (!cover) return end();
    void getComputedStyle(cover).opacity;
    const moves = cover
      .getAnimations({ subtree: true })
      .map((move) => move.finished);
    const late = new Promise((done) => setTimeout(done, 2000));
    Promise.race([Promise.allSettled(moves), late]).then(end);
  };

  const ready = () => {
    const image = [...document.images].find((img) => {
      if (img.closest(".loader_wrap")) return false;
      const box = img.getBoundingClientRect();
      return box.width > 0 && box.bottom > 0 && box.top < innerHeight;
    });
    return Promise.all([
      image && image.decode().catch(() => {}),
      document.fonts && document.fonts.ready,
      until(MIN),
    ]);
  };

  let go = leave;
  if (PRESET === "counter") {
    let shown = 0;
    let done = false;
    let last = start;
    go = () => {
      done = true;
    };
    const count = (now) => {
      if (root.dataset.loader !== "play") return;
      const goal = done ? 1 : 0.9 * (1 - Math.exp(-(now - start) / 700));
      const pull = 1 - Math.exp(-(now - last) / (done ? 90 : 160));
      last = now;
      const near = goal === 1 && 1 - shown < 0.004;
      shown = reduce || near ? goal : shown + (goal - shown) * pull;
      const cover = document.querySelector(".loader_wrap");
      if (cover) {
        cover.style.setProperty("--_progress", shown.toFixed(3));
        const figure = cover.querySelector(".loader_count");
        const n = String(Math.round(shown * 100));
        if (figure && figure.textContent !== n) figure.textContent = n;
      }
      if (shown >= 1) leave();
      else requestAnimationFrame(count);
    };
    requestAnimationFrame(count);
    until(MAX + 600).then(leave);
  }

  until(MAX).then(go);
  if (document.readyState !== "loading") ready().then(go);
  else
    addEventListener("DOMContentLoaded", () => ready().then(go), {
      once: true,
    });
})();
`;

/* Each page carries them: without their comments and line breaks */
const compact = (code: string) =>
  code
    .replace(/\/\*[\s\S]*?\*\//g, "")
    .replace(/\s*\n\s*/g, " ")
    .trim();
---

{
  render && part === "head" && (
    <Fragment>
      <style is:inline set:html={compact(CSS)} />
      <script
        is:inline
        set:html={compact(SCRIPT).replace("__PRESET__", preset)}
      />
    </Fragment>
  )
}

{
  render && part === "cover" && (
    <div
      class:list={[
        "loader_wrap",
        preset !== "mark" && preset,
        preset === "curtain" && "theme-brand",
      ]}
      aria-hidden="true"
    >
      {preset === "custom" && Custom ? (
        <Custom />
      ) : preset === "counter" ? (
        <Fragment>
          <span class="loader_count text-style-display">0</span>
          <span class="loader_line" />
        </Fragment>
      ) : preset === "mark" && icon ? (
        <span class="loader_mark" set:html={icon} />
      ) : (
        <span class="loader_name text-style-h5">{SITE_NAME}</span>
      )}
    </div>
  )
}
